<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZincXManagerClient.ViewModels"
        xmlns:models="using:ZincXManagerClient.Models"
        x:Class="ZincXManagerClient.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ZincXManagerClient"
        Width="1100" Height="700"
        MinWidth="960" MinHeight="620"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Blur,Transparent"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        WindowDecorations="None"
        CanResize="True">

  <Window.Styles>
    <!-- 左侧导航:Win10 Fluent 风格 —— 选中整行变白,左侧强调色小条与白色整行连成一体 -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.nav /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#B4CDDD"/>
    </Style>
    <Style Selector="Button.nav.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.nav Path">
      <Setter Property="Fill" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Foreground" Value="#17303A"/>
    </Style>
    <Style Selector="Button.nav.selected Path">
      <Setter Property="Fill" Value="#2662A7"/>
    </Style>

    <!-- 每行都有的左侧小条:平常是明显的深色轨,选中时高亮成强调色 -->
    <Style Selector="Button.nav Rectangle.bar">
      <Setter Property="Fill" Value="#4F7392"/>
    </Style>
    <Style Selector="Button.nav.selected Rectangle.bar">
      <Setter Property="Fill" Value="#2662A7"/>
    </Style>
    <Style Selector="Button.nav:pointerover Rectangle.bar">
      <Setter Property="Fill" Value="#E2EEF6"/>
    </Style>

    <!-- 标题栏按钮 -->
    <Style Selector="Button.chrome">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.chrome /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3A7CBF"/>
    </Style>

    <!-- 卡片里的链接式按钮 -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Foreground" Value="#2662A7"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- 是 / 否 小按钮(Win10 Fluent 浅色按钮) -->
    <Style Selector="Button.mini">
      <Setter Property="Background" Value="#E9EDF2"/>
      <Setter Property="BorderBrush" Value="#D6DEE6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Foreground" Value="#2B3B44"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="14,2"/>
      <Setter Property="MinWidth" Value="46"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.mini:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#DCE3EA"/>
    </Style>

    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1F3B3A"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.cardBody">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#48696A"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.source">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#7C99A6"/>
    </Style>
  </Window.Styles>

  <Grid>
    <!-- 不再画默认背景:窗口本身透明,未设置背景图时内容区直接透出(系统毛玻璃/桌面) -->
    <!-- 用户设置的背景图(在设置里选择);加一层模糊,前面的栏半透明叠上去就是毛玻璃效果 -->
    <Image Source="{Binding BackgroundImage}" IsVisible="{Binding HasBackgroundImage}"
           Stretch="UniformToFill" Margin="-28">
      <Image.Effect>
        <BlurEffect Radius="26"/>
      </Image.Effect>
    </Image>

    <Grid ColumnDefinitions="236,*" RowDefinitions="44,*">

      <!-- ================= 左侧栏(半透明毛玻璃,透出后面的模糊背景) ================= -->
      <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#A87FA6C4" Offset="0"/>
            <GradientStop Color="#A07396B6" Offset="0.55"/>
            <GradientStop Color="#A06788A6" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>

        <Grid RowDefinitions="Auto,*,Auto" Margin="0,22,0,20">

          <!-- LOGO -->
          <StackPanel Grid.Row="0" Margin="28,0,0,0" Spacing="7">
            <Viewbox Width="122" Height="30" HorizontalAlignment="Left">
              <Canvas Width="36" Height="9">
                <Path Data="{x:Static models:Icons.LogoMark}" Fill="#22403F"
                      Width="36" Height="7" Stretch="Fill" Canvas.Left="0" Canvas.Top="0"/>
                <Path Data="{x:Static models:Icons.LogoSlash}" Fill="#CDE6E5"
                      Width="8" Height="7" Stretch="Fill" Canvas.Left="10" Canvas.Top="0"/>
                <Path Data="{x:Static models:Icons.LogoTriangle}" Fill="#E8F5F4"
                      Width="10" Height="7" Stretch="Fill" Canvas.Left="25" Canvas.Top="2"/>
              </Canvas>
            </Viewbox>
            <TextBlock Text="ZincXManagerClient" FontSize="13.5" Foreground="#1E3A39" LetterSpacing="0.6"/>
          </StackPanel>

          <!-- 导航:整行通到侧栏左边缘,每行左侧都带小条 -->
          <ItemsControl Grid.Row="1" Margin="0,34,0,0" ItemsSource="{Binding NavItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="2"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:NavItem">
                <Button Classes="nav" Classes.selected="{Binding IsSelected}" Click="OnNavItemClick">
                  <Grid ColumnDefinitions="3,*" MinHeight="40">
                    <!-- 贴在界面左边缘的小条,每行都有;选中时由样式高亮 -->
                    <Rectangle Grid.Column="0" Classes="bar"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="28,9,14,9">
                      <Path Data="{Binding Icon}" Width="17" Height="17"
                            Stretch="Uniform" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 用户信息(名称与 ID 由 SetUser 赋值) -->
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="14" Margin="32,0,0,0">
            <Ellipse Width="46" Height="46" Fill="#EDF5FA"/>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding UserName}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding UserId}" Foreground="#E4F1F9" FontSize="12.5"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ================= 标题栏 ================= -->
      <Border Grid.Row="0" Grid.Column="1" Background="#2662A7" PointerPressed="OnTitleBarPointerPressed">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
          <Rectangle Grid.Column="0" Width="1.5" Height="18" Fill="#80FFFFFF" Margin="18,0,0,0" VerticalAlignment="Center"/>

          <TextBlock Grid.Column="1" Text="{Binding ModeText}" Foreground="White" FontSize="14.5"
                     Margin="16,0,0,0" VerticalAlignment="Center"/>

          <Rectangle Grid.Column="2" Width="1.5" Height="18" Fill="#80FFFFFF" Margin="18,0,0,0" VerticalAlignment="Center"/>

          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="20" Margin="22,0,0,0" VerticalAlignment="Center">
            <Button Classes="chrome" Click="OnHelpClick">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{x:Static models:Icons.Help}" Fill="White" Width="15" Height="15"
                      Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="帮助" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Classes="chrome" Click="OnFeedbackClick">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{x:Static models:Icons.Feedback}" Fill="White" Width="14" Height="15"
                      Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="反馈" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <Button Grid.Column="5" Classes="chrome" Width="48" Click="OnMinimizeClick"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <Rectangle Width="13" Height="1.6" Fill="White"/>
          </Button>

          <Button Grid.Column="6" Classes="chrome" Width="54" Background="#E81123" Click="OnCloseClick"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="White" StrokeThickness="1.7"/>
          </Button>
        </Grid>
      </Border>

      <!-- ================= 内容区 + 消息面板 ================= -->
      <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,312">

        <!-- 内容区:设计稿此处留空,让背景透出 -->
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#8AA6B8" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- 消息面板:半透明毛玻璃 -->
        <Border Grid.Column="1" Margin="0,8,10,10"
                Background="#B8EAF4F9" BorderBrush="#8FCBDFEA" BorderThickness="1">
          <Grid RowDefinitions="Auto,*" Margin="14,12,14,10">
            <StackPanel Grid.Row="0" Spacing="6">
              <TextBlock Text="消息" FontSize="17" FontWeight="SemiBold" Foreground="#1F3B3A"/>
              <Rectangle Width="30" Height="2.5" Fill="#2662A7" HorizontalAlignment="Left"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="11">
                <ItemsControl ItemsSource="{Binding Messages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:MessageItem">
                      <Border Background="#E8FFFFFF" BorderBrush="#99D5E5EE" BorderThickness="1"
                              Padding="12,10" Margin="0,0,0,11">
                        <StackPanel Spacing="7">
                          <TextBlock Classes="cardTitle" Text="{Binding Title}"/>
                          <TextBlock Classes="cardBody" Text="{Binding Body}"/>
                          <Rectangle Height="1" Fill="#66E3EEF4"/>

                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="source" Text="{Binding Source}" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">

                              <Button Classes="link" Content="{Binding PrimaryAction}"
                                      IsVisible="{Binding IsUpdate}" Click="OnCardActionClick"/>

                              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsChoice}">
                                <Button Classes="mini" Content="{Binding PrimaryAction}" Click="OnCardActionClick"/>
                                <Button Classes="mini" Content="{Binding SecondaryAction}" Click="OnCardActionClick"/>
                              </StackPanel>

                              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsInput}">
                                <TextBox Text="{Binding InputText}" Width="120" FontSize="12"
                                         Background="#D9FFFFFF" BorderThickness="0,0,0,1" CornerRadius="0"
                                         BorderBrush="#A9C7D8" Padding="2,0" VerticalContentAlignment="Center"/>
                                <Button Classes="link" Content="{Binding PrimaryAction}" Click="OnCardActionClick"/>
                              </StackPanel>

                              <ComboBox IsVisible="{Binding IsSelect}" ItemsSource="{Binding Options}"
                                        SelectedItem="{Binding SelectedOption}" FontSize="12"
                                        MinWidth="86" Background="#D9FFFFFF" BorderThickness="1" CornerRadius="0"
                                        BorderBrush="#99D5E5EE" Padding="6,1"/>
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding EmptyMessage}" Foreground="#6E8F92" FontSize="12.5"
                           HorizontalAlignment="Center" Margin="0,14,0,6"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
