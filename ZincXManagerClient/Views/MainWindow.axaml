<Window Icon="/Assets/zxm-window.png" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZincXManagerClient.ViewModels"
        xmlns:models="using:ZincXManagerClient.Models"
        xmlns:views="using:ZincXManagerClient.Views"
        x:Class="ZincXManagerClient.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ZincXManagerClient"
        Width="1100" Height="700"
        MinWidth="960" MinHeight="620"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Blur,Transparent"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        WindowDecorations="None"
        CanResize="True">

  <Window.Styles>
    <!-- 左侧导航:Win10 Fluent 风格 —— 选中整行变白,左侧强调色小条与白色整行连成一体 -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.nav /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#26FFFFFF"/>
    </Style>
    <Style Selector="Button.nav.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#47FFFFFF"/>
    </Style>
    <Style Selector="Button.nav Path">
      <Setter Property="Fill" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Foreground" Value="#17303A"/>
    </Style>
    <Style Selector="Button.nav.selected Path">
      <Setter Property="Fill" Value="{DynamicResource ThemeOnRail}"/>
    </Style>

    <!-- 每行都有的左侧小条:常态半透明白,选中用主题次要色,悬停用纯白 —— 全部跟主题走 -->
    <Style Selector="Button.nav Rectangle.bar">
      <Setter Property="Fill" Value="#59FFFFFF"/>
    </Style>
    <Style Selector="Button.nav.selected Rectangle.bar">
      <Setter Property="Fill" Value="{DynamicResource ThemeSecondary}"/>
    </Style>
    <Style Selector="Button.nav:pointerover Rectangle.bar">
      <Setter Property="Fill" Value="{DynamicResource ThemeOnRail}"/>
    </Style>

    <!-- 标题栏按钮:背景画在按钮身上并撑满高度,不然上下会留白、点击区域也小 -->
    <Style Selector="Button.chrome">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.chrome /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimaryHover}"/>
    </Style>
    <Style Selector="Button.close">
      <Setter Property="Background" Value="#E81123"/>
    </Style>
    <Style Selector="Button.close /template/ ContentPresenter">
      <Setter Property="Background" Value="#E81123"/>
    </Style>
    <Style Selector="Button.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F1707A"/>
    </Style>

    <!-- 卡片里的链接式按钮 -->
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,4"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1F3B3A"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- 是 / 否 小按钮(Win10 Fluent 浅色按钮) -->
    <Style Selector="Button.mini">
      <Setter Property="Background" Value="#E9EDF2"/>
      <Setter Property="BorderBrush" Value="#D6DEE6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Foreground" Value="#2B3B44"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="14,2"/>
      <Setter Property="MinWidth" Value="46"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.mini:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#DCE3EA"/>
    </Style>

    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1F3B3A"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.cardBody">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#48696A"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.source">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#7C99A6"/>
    </Style>

    <!-- ===== 提示条(toast):跟着卡片走 —— 直角、卡片底色、左边一条强调色 + 一句话 + 一行小字 ===== -->
    <Style Selector="Border.toast">
      <Setter Property="Background" Value="#F2FFFFFF"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemePanelBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="RenderTransform" Value="translateX(-400px)"/>
      <Setter Property="BoxShadow" Value="0 2 9 0 #29000000"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.26"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.toast.in">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="RenderTransform" Value="translateX(0px)"/>
    </Style>
    <!-- 左边那条 + 图标:默认主题色,按口气换颜色 -->
    <Style Selector="Border.toast Rectangle.toastBar">
      <Setter Property="Fill" Value="{DynamicResource ThemePrimary}"/>
    </Style>
    <Style Selector="Border.toast Path.toastIcon">
      <Setter Property="Fill" Value="{DynamicResource ThemePrimary}"/>
    </Style>
    <Style Selector="Border.toast.toastOk Rectangle.toastBar">
      <Setter Property="Fill" Value="#22A05A"/>
    </Style>
    <Style Selector="Border.toast.toastOk Path.toastIcon">
      <Setter Property="Fill" Value="#22A05A"/>
    </Style>
    <Style Selector="Border.toast.toastWarn Rectangle.toastBar">
      <Setter Property="Fill" Value="#F0A020"/>
    </Style>
    <Style Selector="Border.toast.toastWarn Path.toastIcon">
      <Setter Property="Fill" Value="#F0A020"/>
    </Style>
    <Style Selector="Border.toast.toastErr Rectangle.toastBar">
      <Setter Property="Fill" Value="#D64545"/>
    </Style>
    <Style Selector="Border.toast.toastErr Path.toastIcon">
      <Setter Property="Fill" Value="#D64545"/>
    </Style>
    <!-- 一句话:和卡片标题一个色;下面那行小字和卡片的"来源 时间"一个样式 -->
    <Style Selector="TextBlock.toastText">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#1F3B3A"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.toastFoot">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#7C99A6"/>
    </Style>
  </Window.Styles>

  <Grid>
    <!-- 不再画默认背景:窗口本身透明,未设置背景图时内容区直接透出(系统亚克力/桌面) -->
    <!-- 用户设置的背景图(在设置里选择);加一层模糊,前面的栏半透明叠上去就是亚克力效果 -->
    <!-- 模糊半径由代码按"亚克力"开关设置:开 = Fluent 亚克力 30,关 = 0(纯半透明) -->
    <Image x:Name="WallpaperImage" Source="{Binding BackgroundImage}" IsVisible="{Binding HasBackgroundImage}"
           Stretch="UniformToFill" Margin="-28">
      <Image.Effect>
        <BlurEffect Radius="30"/>
      </Image.Effect>
    </Image>

    <Grid ColumnDefinitions="236,*" RowDefinitions="44,*">

      <!-- ================= 左侧栏(半透明亚克力,透出后面的模糊背景) ================= -->
      <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource ThemeGlass}">


        <Grid RowDefinitions="Auto,*,Auto" Margin="0,22,0,20">

          <!-- LOGO -->
          <StackPanel Grid.Row="0" Margin="28,0,0,0" Spacing="7">
            <Viewbox Width="122" Height="30" HorizontalAlignment="Left">
              <Canvas Width="36" Height="9">
                <Path Data="{x:Static models:Icons.LogoMark}" Fill="{DynamicResource ThemeOnRail}"
                      Width="36" Height="7" Stretch="Fill" Canvas.Left="0" Canvas.Top="0"/>
                <Path Data="{x:Static models:Icons.LogoSlash}" Fill="{DynamicResource ThemeOnRailSoft}"
                      Width="8" Height="7" Stretch="Fill" Canvas.Left="10" Canvas.Top="0"/>

              </Canvas>
            </Viewbox>
            <TextBlock Text="ZincXManagerClient" FontSize="13.5" Foreground="{DynamicResource ThemeOnRail}" LetterSpacing="0.6"/>
          </StackPanel>

          <!-- 导航:整行通到侧栏左边缘,每行左侧都带小条 -->
          <ItemsControl Grid.Row="1" Margin="0,34,0,0" ItemsSource="{Binding NavItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="2"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:NavItem">
                <Button Classes="nav" Classes.selected="{Binding IsSelected}" Click="OnNavItemClick">
                  <Grid ColumnDefinitions="3,*" MinHeight="40">
                    <!-- 贴在界面左边缘的小条,每行都有;选中时由样式高亮 -->
                    <Rectangle Grid.Column="0" Classes="bar"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="28,9,14,9">
                      <Path Data="{Binding Icon}" Width="17" Height="17"
                            Stretch="Uniform" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 用户信息(名称与 ID 由 SetUser 赋值) -->
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="14" Margin="32,0,0,0">
            <!-- 头像:有图就圆形裁剪显示,没有就给个浅色圆 -->
            <Panel Width="52" Height="52" VerticalAlignment="Center">
              <Ellipse Fill="{DynamicResource ThemeSecondary}" IsVisible="{Binding !HasAvatar}"/>
              <Ellipse IsVisible="{Binding HasAvatar}">
                <Ellipse.Fill>
                  <ImageBrush Source="{Binding Avatar}" Stretch="UniformToFill"/>
                </Ellipse.Fill>
              </Ellipse>
            </Panel>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding UserName}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding UserId}" Foreground="#E4F1F9" FontSize="12.5"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ================= 标题栏 ================= -->
      <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource ThemePrimary}" PointerPressed="OnTitleBarPointerPressed">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
          <Rectangle Grid.Column="0" Width="1.5" Height="18" Fill="#80FFFFFF" Margin="18,0,0,0" VerticalAlignment="Center"/>

          <TextBlock Grid.Column="1" Text="{Binding ModeText}" Foreground="White" FontSize="14.5"
                     Margin="16,0,0,0" VerticalAlignment="Center"/>

          <Rectangle Grid.Column="2" Width="1.5" Height="18" Fill="#80FFFFFF" Margin="18,0,0,0" VerticalAlignment="Center"/>

          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="20" Margin="22,0,0,0" VerticalAlignment="Center">
            <Button Classes="chrome" Padding="10,0" Click="OnHelpClick">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{x:Static models:Icons.Help}" Fill="White" Width="15" Height="15"
                      Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="帮助" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Classes="chrome" Padding="10,0" Click="OnFeedbackClick">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{x:Static models:Icons.Feedback}" Fill="White" Width="14" Height="15"
                      Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="反馈" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <Button Grid.Column="5" Classes="chrome" Width="48" Click="OnMinimizeClick"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <Rectangle Width="13" Height="1.6" Fill="White"/>
          </Button>

          <Button Grid.Column="6" Classes="chrome close" Width="54" Click="OnCloseClick"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="White" StrokeThickness="1.7"/>
          </Button>
        </Grid>
      </Border>

      <!-- ================= 右侧:设置页 或 内容区+消息面板 ================= -->
      <Grid Grid.Row="1" Grid.Column="1" Background="{DynamicResource ThemePanel}">

        <!-- 非设置页时铺一层浅色磨砂底:窗口透明,只靠壁纸的话浅色壁纸下会显得空 -->
        <Rectangle Fill="{DynamicResource ThemeContentVeil}" IsVisible="{Binding !IsSettings}"/>

        <!-- 设置页(左侧导航选"设置"时显示);套一层 Grid,避免 IsVisible 被新 DataContext 解析 -->
        <Grid IsVisible="{Binding IsSettings}">
          <views:SettingsView x:Name="SettingsPage" DataContext="{Binding Settings}"/>
        </Grid>

        <!-- 内容区 + 消息面板 -->
        <Grid ColumnDefinitions="*,312" IsVisible="{Binding !IsSettings}">

        <!-- 内容区:设计稿此处留空,让背景透出 -->
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#8AA6B8" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- 消息面板:半透明亚克力 -->
        <Border Grid.Column="1" Margin="0,8,10,10"
                Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1">
          <Grid RowDefinitions="Auto,*" Margin="14,12,14,10">
            <StackPanel Grid.Row="0" Spacing="2">
              <!-- 页签多 / 名字长的时候横向滚动,别把后面的挤没 -->
              <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <StackPanel Spacing="2">
              <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:MessageTab">
                    <Button Classes="tab" Content="{Binding Label}" Click="OnTabClick" Width="{Binding Width}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- 蓝色小条:跟着选中的页签滑过去(放在画布里,宽度=所有页签总宽,滚动时一起走) -->
              <Canvas Width="{Binding TabsWidth}" Height="4" HorizontalAlignment="Left">
                <Rectangle x:Name="TabUnderline" Canvas.Left="0" Width="30" Height="2.5"
                           Fill="{DynamicResource ThemePrimary}" RenderTransformOrigin="0,0.5">
                  <Rectangle.RenderTransform>
                    <TranslateTransform X="{Binding UnderlineOffset}"/>
                  </Rectangle.RenderTransform>
                </Rectangle>
              </Canvas>
              </StackPanel>
              </ScrollViewer>
            </StackPanel>

            <ScrollViewer x:Name="MessagesScroller" Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsTabMessages}">
              <StackPanel Spacing="11">
                <ItemsControl ItemsSource="{Binding Messages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:MessageItem">
                      <Border Background="{DynamicResource ThemeGlassLight}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1"
                              Padding="12,10" Margin="0,0,0,11">
                        <StackPanel Spacing="7">
                          <!-- 标题 + 时间 + 右上角删除(时间放在删除键左侧;删掉的同时从本地存档里去掉) -->
                          <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Classes="cardTitle" Text="{Binding Title}"/>
                            <TextBlock Grid.Column="1" Classes="source" Text="{Binding TimeText}"
                                       VerticalAlignment="Center" Opacity="0.75" Margin="8,0,0,0"/>
                            <Button Grid.Column="2" Classes="link" Content="删除" Click="OnDeleteMessageClick"
                                    Foreground="#B25555" VerticalAlignment="Center" Margin="10,0,0,0"/>
                          </Grid>
                          <TextBlock Classes="cardBody" Text="{Binding Body}"/>
                          <Rectangle Height="1" Fill="#66E3EEF4"/>

                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                              <TextBlock Classes="source" Text="{Binding Source}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">

                              <Button Classes="link" Content="{Binding PrimaryAction}"
                                      IsVisible="{Binding IsUpdate}" Click="OnCardActionClick"/>

                              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsChoice}">
                                <Button Classes="mini" Content="{Binding PrimaryAction}" Click="OnCardActionClick"/>
                                <Button Classes="mini" Content="{Binding SecondaryAction}" Click="OnCardActionClick"/>
                              </StackPanel>

                              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsInput}">
                                <TextBox Text="{Binding InputText}" Width="120" FontSize="12"
                                         Background="#D9FFFFFF" BorderThickness="0,0,0,1" CornerRadius="0"
                                         BorderBrush="#A9C7D8" Padding="2,0" VerticalContentAlignment="Center"/>
                                <Button Classes="link" Content="{Binding PrimaryAction}" Click="OnCardActionClick"/>
                              </StackPanel>

                              <!-- 下拉框 + 确认:选完点确认才上报(免得滚轮滚过就改掉选择) -->
                              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsSelect}">
                                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                          FontSize="12" MinWidth="86" Background="#D9FFFFFF" BorderThickness="1"
                                          CornerRadius="0" BorderBrush="#99D5E5EE" Padding="6,1"/>
                                <Button Classes="link" Content="确认" Click="OnCardActionClick"/>
                              </StackPanel>


                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding EmptyMessage}" Foreground="#6E8F92" FontSize="12.5"
                           HorizontalAlignment="Center" Margin="0,14,0,6"
                           IsVisible="{Binding !HasMessages}"/>
              </StackPanel>
            </ScrollViewer>

            <!-- 日志:ZXMC 运行日志 -->
            <Grid Grid.Row="1" IsVisible="{Binding IsTabLog}" RowDefinitions="Auto,*" Margin="0,10,0,0">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Classes="source" Text="最近一份运行日志(末尾 400 行)" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="link" Content="刷新" Click="OnRefreshLogClick"/>
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding LogText}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5"
                                     Foreground="#31505F" TextWrapping="Wrap"/>
              </ScrollViewer>
            </Grid>

            <!-- 更新日志:根目录 UpdateLog.MD -->
            <Grid Grid.Row="1" IsVisible="{Binding IsTabChangelog}" RowDefinitions="Auto,*" Margin="0,10,0,0">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Classes="source" Text="根目录 UpdateLog.MD" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="link" Content="刷新" Click="OnRefreshChangelogClick"/>
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding ChangelogText}" FontSize="12.5" Foreground="#31505F" TextWrapping="Wrap"/>
              </ScrollViewer>
            </Grid>

            <!-- 自定义网页 -->
            <Grid Grid.Row="1" IsVisible="{Binding IsTabWeb}" RowDefinitions="Auto,*" Margin="0,10,0,0">
              <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
                <TextBlock Classes="source" Text="{Binding WebUrl}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="link" Content="重新载入" Click="OnLoadWebClick"/>
                  <Button Classes="link" Content="在浏览器打开" Click="OnOpenWebClick"/>
                </StackPanel>
              </StackPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding WebText}" FontSize="12" Foreground="#31505F" TextWrapping="Wrap"/>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- ================= 提示条(最上层):从左上角滑出来,几秒后自己收回去 ================= -->
    <ItemsControl ItemsSource="{Binding Toasts}" Width="330" Margin="16,58,0,0"
                  HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="models:ToastItem">
          <Border Classes="toast" Classes.toastOk="{Binding IsSuccess}" Classes.toastWarn="{Binding IsWarning}"
                  Classes.toastErr="{Binding IsError}" Loaded="OnToastLoaded">
            <Grid ColumnDefinitions="4,*">
              <Rectangle Grid.Column="0" Classes="toastBar"/>
              <StackPanel Grid.Column="1" Margin="11,9,13,9" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Classes="toastIcon" Data="{x:Static models:Icons.Help}" Width="14" Height="14"
                        Stretch="Uniform" VerticalAlignment="Center"/>
                  <TextBlock Classes="toastText" Text="{Binding Text}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Classes="toastFoot" Text="{Binding FootText}"/>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Window>
