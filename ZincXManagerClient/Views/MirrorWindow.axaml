<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ZincXManagerClient.Models"
        x:Class="ZincXManagerClient.Views.MirrorWindow"
        Title="下载镜像"
        Width="640" Height="480"
        Background="#CCFFFFFF"
        TransparencyLevelHint="AcrylicBlur,Blur,Transparent"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="Button.chrome">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.chrome /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimaryHover}"/>
    </Style>
    <Style Selector="Button.close /template/ ContentPresenter">
      <Setter Property="Background" Value="#E81123"/>
    </Style>
    <Style Selector="Button.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F1707A"/>
    </Style>
    <Style Selector="Button.act">
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.act /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.act.cancel">
      <Setter Property="Background" Value="{DynamicResource ThemeLight}"/>
      <Setter Property="Foreground" Value="#1F3B3A"/>
    </Style>
    <Style Selector="Button.act.cancel /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeLight}"/>
    </Style>
    <Style Selector="Button.act.go">
      <Setter Property="Background" Value="{DynamicResource ThemePrimary}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.act.go /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimary}"/>
    </Style>
    <Style Selector="Button.act.go:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimaryHover}"/>
    </Style>
    <Style Selector="Button.rowbtn">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.rowbtn /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.rowbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeLight}"/>
    </Style>
  </Window.Styles>

  <Border Background="#F7FFFFFF" BorderBrush="{DynamicResource ThemeMuted}" BorderThickness="1" Margin="1">
    <Grid RowDefinitions="40,*,Auto">

      <Border Grid.Row="0" Background="{DynamicResource ThemePrimary}" PointerPressed="OnTitleBarPointerPressed">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Text="下载镜像" Foreground="White" FontSize="13"
                     Margin="16,0,0,0" VerticalAlignment="Center"/>
          <Button Grid.Column="2" Classes="chrome close" Width="52" Click="OnCancelClick">
            <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="White" StrokeThickness="1.7"/>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="16,12,16,0">

        <!-- 表头 -->
        <Grid Grid.Row="0" ColumnDefinitions="56,*,150,54,30" Margin="0,0,0,6">
          <TextBlock Grid.Column="0" Text="优先级" FontSize="12" Foreground="#4A6B78"/>
          <TextBlock Grid.Column="1" Text="镜像源地址" FontSize="12" Foreground="#4A6B78"/>
          <TextBlock Grid.Column="2" Text="名称(可选)" FontSize="12" Foreground="#4A6B78"/>
          <TextBlock Grid.Column="3" Text="启用" FontSize="12" Foreground="#4A6B78" HorizontalAlignment="Center"/>
        </Grid>

        <!-- 列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="270">
          <ListBox x:Name="MirrorList" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:MirrorItem">
                <Grid ColumnDefinitions="56,*,150,54,30" Margin="0,2">
                  <!-- 交换优先级 -->
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="rowbtn" Content="▲" FontSize="10" Click="OnMoveUpClick" Tag="{Binding}"/>
                    <Button Classes="rowbtn" Content="▼" FontSize="10" Click="OnMoveDownClick" Tag="{Binding}"/>
                  </StackPanel>

                  <TextBox Grid.Column="1" Text="{Binding Url, Mode=TwoWay}" Height="30"
                           Watermark="https://gh-proxy.com/" Margin="0,0,6,0"/>

                  <ComboBox Grid.Column="2" Height="30" Margin="0,0,6,0"
                            IsEditable="True"
                            Text="{Binding Name, Mode=TwoWay}"
                            PlaceholderText="可空">
                    <ComboBoxItem Content="gh-proxy"/>
                    <ComboBoxItem Content="ghfast"/>
                    <ComboBoxItem Content="ghproxy"/>
                    <ComboBoxItem Content="自建"/>
                  </ComboBox>

                  <CheckBox Grid.Column="3" IsChecked="{Binding Enabled, Mode=TwoWay}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </Grid>

      <!-- 底部:左"添加",右"取消/保存" -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="16,10,16,16">
        <Button Grid.Column="0" Classes="act cancel" Content="+ 添加镜像源" Click="OnAddClick"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
          <Button Classes="act cancel" Content="取消" Click="OnCancelClick"/>
          <Button Classes="act go" Content="保存" Click="OnSaveClick"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
