<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZincXManagerClient.Views.MirrorWindow"
        Title="下载镜像"
        Width="480" Height="420"
        Background="#CCFFFFFF"
        TransparencyLevelHint="AcrylicBlur,Blur,Transparent"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="Button.chrome">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.chrome /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimaryHover}"/>
    </Style>
    <Style Selector="Button.close /template/ ContentPresenter">
      <Setter Property="Background" Value="#E81123"/>
    </Style>
    <Style Selector="Button.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F1707A"/>
    </Style>
    <Style Selector="Button.act">
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.act /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.act.cancel">
      <Setter Property="Background" Value="{DynamicResource ThemeLight}"/>
      <Setter Property="Foreground" Value="#1F3B3A"/>
    </Style>
    <Style Selector="Button.act.cancel /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeLight}"/>
    </Style>
    <Style Selector="Button.act.go">
      <Setter Property="Background" Value="{DynamicResource ThemePrimary}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.act.go /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimary}"/>
    </Style>
    <Style Selector="Button.act.go:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimaryHover}"/>
    </Style>
  </Window.Styles>

  <Border Background="#F7FFFFFF" BorderBrush="{DynamicResource ThemeMuted}" BorderThickness="1" Margin="1">
    <Grid RowDefinitions="40,*,Auto">

      <Border Grid.Row="0" Background="{DynamicResource ThemePrimary}" PointerPressed="OnTitleBarPointerPressed">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Text="下载镜像" Foreground="White" FontSize="13"
                     Margin="16,0,0,0" VerticalAlignment="Center"/>
          <Button Grid.Column="2" Classes="chrome close" Width="52" Click="OnCancelClick">
            <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="White" StrokeThickness="1.7"/>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="190,*" Margin="16,14,16,0">
        <!-- 预设列表:点一下填进右边输入框 -->
        <StackPanel Grid.Column="0" Spacing="6">
          <TextBlock Classes="label" Text="预置镜像(点一下填入)"/>
          <ListBox x:Name="PresetList" Height="250" SelectionChanged="OnPresetSelected">
            <ListBoxItem Content="https://gh-proxy.com/"/>
            <ListBoxItem Content="https://ghfast.top/"/>
            <ListBoxItem Content="https://ghproxy.net/"/>
            <ListBoxItem Content="gh-proxy + ghfast"/>
            <ListBoxItem Content="三个都填(按顺序试)"/>
          </ListBox>
        </StackPanel>

        <!-- 地址输入 -->
        <StackPanel Grid.Column="1" Spacing="8" Margin="14,0,0,0">
          <TextBlock Classes="label" Text="下载地址前缀"/>
          <TextBox x:Name="MirrorBox" AcceptsReturn="True" TextWrapping="Wrap"
                   Height="120" VerticalContentAlignment="Top"
                   Watermark="留空 = 只走官方源"/>
          <TextBlock Classes="tips" TextWrapping="Wrap"
                     Text="可以填多个,用英文分号(;)分隔,下载时按顺序试,全连不上自动退回官方源。"/>
          <TextBlock Classes="tips" TextWrapping="Wrap"
                     Text="作用:下载更新包时把镜像地址拼在原下载地址前面,解决直连 GitHub 下不动的问题。"/>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                  Spacing="10" Margin="16,14,16,16">
        <Button Classes="act cancel" Content="取消" Click="OnCancelClick"/>
        <Button Classes="act go" Content="确定" Click="OnOkClick"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
