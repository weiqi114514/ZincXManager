<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZincXManagerClient.Views.FriendsWindow"
        Title="ZincXManagerClient · 好友"
        Width="240" Height="660" MinWidth="320" MinHeight="400"
        Background="{DynamicResource ThemeWindowVeil}"
        TransparencyLevelHint="AcrylicBlur,Blur,Transparent"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        WindowDecorations="None">

  <Window.Styles>
    <Style Selector="Border.friendRow">
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.friendRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource ThemeLight}"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="33,Auto,*,Auto">
    <!-- 标题栏 -->
    <Border Grid.Row="0" Background="{DynamicResource ThemePrimary}" PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Rectangle Grid.Column="0" Width="1.5" Height="16" Fill="#80FFFFFF" Margin="16,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="好友" Foreground="White" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Classes="chrome" Width="40" Click="OnMinimizeClick">
          <Rectangle Width="12" Height="1.5" Fill="White"/>
        </Button>
        <Button Grid.Column="3" Classes="chrome close" Width="44" Click="OnCloseClick">
          <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="White" StrokeThickness="1.6"/>
        </Button>
      </Grid>
    </Border>

    <!-- 搜索 -->
    <TextBox Grid.Row="1" Margin="12,10,12,6" Watermark="搜索好友" FontSize="12"/>

    <!-- 好友列表(占位;以后接真实数据) -->
    <ScrollViewer Grid.Row="2" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="10,4,10,10" Spacing="2">

        <!-- 占位好友:双击打开聊天窗体(接真实数据时换成 ItemsControl) -->
        <Border Classes="friendRow" Padding="10,8" Background="Transparent" DoubleTapped="OnFriendDoubleTapped" Tag="示例好友">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="28" Height="28" Background="{DynamicResource ThemeLight}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1">
              <TextBlock Text="?" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource ThemeMuted}"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="示例好友" FontSize="12.5" Foreground="{DynamicResource ThemePrimaryDark}"/>
              <TextBlock Text="占位 · 双击打开聊天" FontSize="11" Foreground="{DynamicResource ThemeMuted}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="暂无其它好友" FontSize="12" HorizontalAlignment="Center" Margin="0,20,0,0"
                   Foreground="{DynamicResource ThemeMuted}"/>
      </StackPanel>
    </ScrollViewer>

    <!-- 底:提示 -->
    <Border Grid.Row="3" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="0,1,0,0" Padding="12,8">
      <TextBlock Text="双击好友打开聊天窗口" FontSize="11" Foreground="{DynamicResource ThemeMuted}"/>
    </Border>
  </Grid>
</Window>
