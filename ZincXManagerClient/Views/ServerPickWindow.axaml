<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZincXManagerClient.Views.ServerPickWindow"
        Title="选择 MC 服务器"
        Width="520" Height="420" CanResize="False"
        Background="{DynamicResource ThemeWindowVeil}"
        TransparencyLevelHint="AcrylicBlur,Blur,Transparent"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        WindowDecorations="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <!-- 标题栏按钮:和项目其它窗口同一套(chrome 透明底 / close 红底) -->
    <Style Selector="Button.chrome">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.chrome /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimaryHover}"/>
    </Style>
    <Style Selector="Button.close">
      <Setter Property="Background" Value="#E81123"/>
    </Style>
    <Style Selector="Button.close /template/ ContentPresenter">
      <Setter Property="Background" Value="#E81123"/>
    </Style>
    <Style Selector="Button.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F1707A"/>
    </Style>

    <!-- 服务器行:整行可点;悬停浅蓝、选中主题蓝(比悬停重,选中那行一眼能看出来) -->
    <Style Selector="Border.pickRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.pickRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource ThemeLight}"/>
    </Style>
    <Style Selector="Border.pickRow.selected">
      <Setter Property="Background" Value="{DynamicResource ThemeSecondary}"/>
    </Style>

    <!-- 右下按钮:主按钮 = 主题色,次按钮 = 浅色(抄 MessageDialog 的 dbtn) -->
    <Style Selector="Button.dbtn">
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="84"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.dbtn.primary">
      <Setter Property="Background" Value="{DynamicResource ThemePrimary}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.dbtn.primary /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimary}"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.dbtn.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimaryHover}"/>
    </Style>
    <Style Selector="Button.dbtn.secondary">
      <Setter Property="Background" Value="{DynamicResource ThemeLight}"/>
      <Setter Property="Foreground" Value="#1F3B3A"/>
    </Style>
    <Style Selector="Button.dbtn.secondary /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeLight}"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.dbtn.secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeSecondary}"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="40,*,Auto">

    <!-- 标题栏:左侧白色小条 + 弹窗名 + 红色关闭 -->
    <Border Grid.Row="0" Background="{DynamicResource ThemePrimary}" PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Rectangle Grid.Column="0" Width="1.5" Height="16" Fill="#80FFFFFF" Margin="16,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="选择 MC 服务器" Foreground="White" FontSize="13"
                   Margin="14,0,0,0" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Classes="chrome close" Width="44" Click="OnCancelClick">
          <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="White" StrokeThickness="1.6"/>
        </Button>
      </Grid>
    </Border>

    <!-- 列表区:白色底 + 一行一台服务器;没有数据时中间显示提示 -->
    <Border Grid.Row="1" Margin="16,12,16,0"
            Background="{DynamicResource ThemeGlassLight}"
            BorderBrush="{DynamicResource ThemePanelBorder}"
            BorderThickness="1">
      <Panel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
          <StackPanel x:Name="RowsHost" Spacing="2"/>
        </ScrollViewer>
        <TextBlock x:Name="EmptyText" Text="服务端没有登记服务器"
                   FontSize="12.5" Foreground="{DynamicResource ThemeMuted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
      </Panel>
    </Border>

    <!-- 底栏:左下提示,右下取消 / 应用 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="16,10,16,14">
      <TextBlock Grid.Column="0" Text="切换后看到的是那台服的数据" FontSize="12" Foreground="#4A6B78"
                 VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <Button Classes="dbtn secondary" Content="取消" Click="OnCancelClick"/>
        <Button x:Name="ApplyButton" Classes="dbtn primary" Content="应用" IsEnabled="False" Click="OnApplyClick"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
