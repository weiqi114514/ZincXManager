<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:ZincXManagerClient.Models"
             x:Class="ZincXManagerClient.Views.FunctionPickerView">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource ThemeGlassLight}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemePanelBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Width" Value="420"/>
      <Setter Property="Height" Value="126"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Padding" Value="18,16"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.card:pointerover">
      <Setter Property="Background" Value="#B8FFFFFF"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
    </Style>
    <Style Selector="Path.cardIconStroke">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Stroke" Value="{DynamicResource ThemePrimaryDark}"/>
      <Setter Property="StrokeThickness" Value="1.8"/>
      <Setter Property="Fill" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Path.cardIcon">
      <Setter Property="Width" Value="52"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Fill" Value="{DynamicResource ThemePrimaryDark}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1F3B3A"/>
    </Style>
    <Style Selector="TextBlock.cardDesc">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="#5A7480"/>
    </Style>
    <Style Selector="Button.go">
      <Setter Property="Background" Value="{DynamicResource ThemePrimary}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.go /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.go:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimaryHover}"/>
    </Style>
    <Style Selector="Button.go:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimaryDark}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="18,16,16,16">
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock x:Name="TitleText" Text="" FontSize="22" FontWeight="SemiBold" Foreground="#1F3B3A"/>
      <Rectangle Width="34" Height="2.5" Fill="{DynamicResource ThemePrimary}" HorizontalAlignment="Left"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="ItemsHost">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="12"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:FunctionItem">
            <Border Classes="card" IsVisible="{Binding IsVisible}" Tag="{Binding Key}" PointerPressed="OnCardPressed">
              <Grid>
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="16,0,0,0" VerticalAlignment="Center">
                  <Path Classes="cardIcon" Data="{Binding Icon}" IsVisible="{Binding ShowVectorIcon}"/>
                  <Path Classes="cardIconStroke" Data="{Binding Icon}" IsVisible="{Binding ShowStrokeIcon}"/>
                  <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="cardTitle" Text="{Binding Title}"/>
                    <TextBlock Classes="cardDesc" Text="{Binding Description}"/>
                  </StackPanel>
                </StackPanel>
                <Button Classes="go" Content="进入" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Tag="{Binding Key}" Click="OnEnterClick"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
