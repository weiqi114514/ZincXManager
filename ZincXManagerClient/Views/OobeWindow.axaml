<Window Icon="/Assets/zxm-window.png" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZincXManagerClient.ViewModels"
        xmlns:models="using:ZincXManagerClient.Models"
        x:Class="ZincXManagerClient.Views.OobeWindow"
        x:DataType="vm:OobeViewModel"
        Title="ZincXManagerClient · 首次使用"
        Width="1100" Height="700"
        MinWidth="960" MinHeight="620"
        Background="{DynamicResource ThemeWindowVeil}"
        TransparencyLevelHint="AcrylicBlur,Blur,Transparent"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        CanResize="True">

  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="46"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1F3B3A"/>
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1F3B3A"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#5C7A88"/>
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Foreground" Value="#3E5C6B"/>
    </Style>
    <Style Selector="TextBlock.steps">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="#6E8A98"/>
    </Style>

    <Style Selector="TextBlock.chip">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="#9BB0BC"/>
    </Style>
    <Style Selector="TextBlock.chip.current">
      <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource ThemePrimary}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="22,8"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimary}"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimaryHover}"/>
    </Style>

    <!-- 禁用态:不能用的时候明确变灰 -->
    <Style Selector="Button.primary:disabled">
      <Setter Property="Foreground" Value="#F2F6F8"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#B6C4CE"/>
    </Style>
    <Style Selector="Button.secondary:disabled">
      <Setter Property="Foreground" Value="#9FB0BA"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="Button.secondary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#E2E9EE"/>
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource ThemeLight}"/>
      <Setter Property="Foreground" Value="#1F3B3A"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.secondary /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeLight}"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="Button.chrome">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF"/>
    </Style>
    <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E81123"/>
    </Style>

    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="96"/>
      <Setter Property="Height" Value="64"/>
      <Setter Property="BorderThickness" Value="3"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Border.thumb">
      <Setter Property="Width" Value="220"/>
      <Setter Property="Height" Value="130"/>
      <Setter Property="BorderThickness" Value="3"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.thumb.active">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
    </Style>

    <Style Selector="Button.mode">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryDark}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.mode:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="TextBox.field">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="44,*,64">

    <!-- 标题栏 -->
    <Border Grid.Row="0" Background="{DynamicResource ThemePrimary}" PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Rectangle Grid.Column="0" Width="1.5" Height="16" Fill="#80FFFFFF" Margin="16,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="ZincXManagerClient · 首次使用引导" Foreground="White" FontSize="13"
                   Margin="14,0,0,0" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Classes="chrome" Width="48" Click="OnMinimizeClick">
          <Rectangle Width="13" Height="1.6" Fill="White"/>
        </Button>
        <Button Grid.Column="3" Classes="chrome close" Width="54" Click="OnCloseClick">
          <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="White" StrokeThickness="1.7"/>
        </Button>
      </Grid>
    </Border>

    <!-- 内容 -->
    <Grid Grid.Row="1" Margin="32,18,32,0" RowDefinitions="Auto,*">

      <!-- 进度(右上角) -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
        <TextBlock Classes="label" Text="{Binding StepText}" VerticalAlignment="Center"/>
        <ProgressBar Width="140" Height="4" Minimum="0" Maximum="100" Value="{Binding ProgressValue}"
                     VerticalAlignment="Center"/>
        <ItemsControl ItemsSource="{Binding Chips}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:StepChip">
              <TextBlock Classes="chip" Classes.current="{Binding IsCurrent}" Text="{Binding Name}"
                         VerticalAlignment="Center"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- ① 欢迎:Zinc[变化的词]Manager -->
      <Grid Grid.Row="1" IsVisible="{Binding IsWelcome}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="10" Margin="0,0,0,40">
          <Grid ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
            <TextBlock Grid.Column="0" Classes="h1" Text="Zinc"/>
            <!-- 会变的那一段:上下滑动切换 -->
            <Border Grid.Column="1" x:Name="XSlot" ClipToBounds="True" VerticalAlignment="Center">
              <Grid x:Name="XStack">
                <TextBlock x:Name="XCurrent" Classes="h1" Text="X"/>
                <TextBlock x:Name="XIncoming" Classes="h1" Text="Admin" IsVisible="False"/>
              </Grid>
            </Border>
            <TextBlock Grid.Column="2" x:Name="ManagerText" Classes="h1" Text="Manager"/>
          </Grid>
          <TextBlock Classes="body" Text="欢迎使用" FontSize="18"/>
          <TextBlock Classes="label" Text="一套 Minecraft 服务器管理工具:协议、账号、消息与运维集中在一处。" TextWrapping="Wrap" MaxWidth="560"/>
        </StackPanel>
      </Grid>

      <!-- ② 配色 -->
      <Grid Grid.Row="1" IsVisible="{Binding IsTheme}" RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Classes="h2" Text="选择你喜欢的配色"/>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding ThemeOptions}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:ThemeOption">
              <StackPanel Margin="12,10" Width="100">
                <Button Classes="swatch" Tag="{Binding Name}" Click="OnThemeClick"
                        Background="{Binding Light}" BorderBrush="{Binding Primary}">
                  <StackPanel Spacing="3">
                    <Rectangle Height="14" Fill="{Binding Primary}"/>
                    <Rectangle Height="10" Fill="{Binding Secondary}"/>
                    <Rectangle Height="6" Fill="{Binding Light}"/>
                  </StackPanel>
                </Button>
                <TextBlock Classes="label" Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <!-- ③ 透明样式 -->
      <Grid Grid.Row="1" IsVisible="{Binding IsGlass}" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Classes="h2" Text="选择你喜欢的透明样式"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="28" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="8">
            <Border Classes="thumb" Classes.active="{Binding GlassEnabled}" Tag="glass" PointerPressed="OnGlassPick"
                    Background="#BFFFFFFF">
              <StackPanel Margin="14" Spacing="6">
                <Rectangle Height="18" Fill="#D8E9F5"/>
                <Rectangle Height="34" Fill="#8FB6CF" Opacity="0.55"/>
                <Rectangle Height="18" Fill="#D8E9F5"/>
              </StackPanel>
            </Border>
            <TextBlock Classes="label" Text="毛玻璃(亚克力模糊)" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel Spacing="8">
            <Border Classes="thumb" Classes.active="{Binding !GlassEnabled}" Tag="plain" PointerPressed="OnGlassPick"
                    Background="#F2FFFFFF">
              <StackPanel Margin="14" Spacing="6">
                <Rectangle Height="18" Fill="#D8E9F5"/>
                <Rectangle Height="34" Fill="#C9DCE8"/>
                <Rectangle Height="18" Fill="#D8E9F5"/>
              </StackPanel>
            </Border>
            <TextBlock Classes="label" Text="半透明(不模糊,省性能)" HorizontalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,320,Auto" Margin="0,10,0,24" HorizontalAlignment="Center">
          <TextBlock Grid.Column="0" Classes="label" Text="不透明度" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Slider Grid.Column="1" Minimum="50" Maximum="100" Value="{Binding OpacityPercent}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Classes="label" Text="{Binding OpacityHint}" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>
      </Grid>

      <!-- ④ 消息分类 -->
      <Grid Grid.Row="1" IsVisible="{Binding IsMessages}" RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Classes="h2" Text="添加你喜欢的消息分类"/>
        <StackPanel Grid.Row="1" Spacing="10" VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Center">
          <TextBlock Classes="label" TextWrapping="Wrap"
                     Text="消息窗口可以显示更多内容:勾选后,主界面消息面板会出现对应的分类页签。"/>
          <CheckBox Content="消息" IsChecked="True" IsEnabled="False"/>
          <CheckBox Content="日志(ZXMC 运行日志)" IsChecked="{Binding CategoryLog}"/>
          <CheckBox Content="更新日志(根目录 UpdateLog.MD)" IsChecked="{Binding CategoryChangelog}"/>
          <CheckBox Content="自定义网页" IsChecked="{Binding CategoryWeb}"/>
          <TextBox Classes="field" Watermark="页签名称(例如:社区公告)" Text="{Binding WebName}"
                   IsVisible="{Binding ShowWebUrl}"/>
          <TextBox Classes="field" Watermark="网页地址 https://example.com" Text="{Binding WebUrl}"
                   IsVisible="{Binding ShowWebUrl}"/>
        </StackPanel>
      </Grid>

      <!-- ⑤ 数据源添加 -->
      <Grid Grid.Row="1" IsVisible="{Binding IsDataSource}" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Spacing="6" HorizontalAlignment="Center">
          <TextBlock Classes="h2" Text="添加数据源" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
          <TextBlock Classes="label" Text="模式选择" HorizontalAlignment="Center"/>
          <Border Background="{DynamicResource ThemeLight}" BorderBrush="{DynamicResource ThemeMuted}" BorderThickness="1" CornerRadius="3"
                  HorizontalAlignment="Center" Padding="3">
            <Grid x:Name="ModeGroup" ColumnDefinitions="92,92,92">
              <!-- 高亮块:选哪个就滑到哪个下面 -->
              <Border x:Name="ModeHighlight" Width="92" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Background="{DynamicResource ThemeSecondary}" CornerRadius="2" IsHitTestVisible="False">
                <Border.RenderTransform>
                  <TranslateTransform X="0"/>
                </Border.RenderTransform>
              </Border>
              <Button Grid.Column="0" Classes="mode" Content="SAOS" Tag="SAOS" Click="OnModeClick"/>
              <Button Grid.Column="1" Classes="mode" Content="OS" Tag="OS" Click="OnModeClick"/>
              <Button Grid.Column="2" Classes="mode" Content="OOS" Tag="OOS" Click="OnModeClick"/>
            </Grid>
          </Border>

          <TextBlock Classes="label" Text="连接端 IP" HorizontalAlignment="Center" Margin="0,8,0,0"/>
          <TextBox Classes="field" Text="{Binding CzIp}" HorizontalAlignment="Center" Width="320"/>

          <TextBlock Classes="label" Text="连接端端口" HorizontalAlignment="Center"/>
          <TextBox Classes="field" Text="{Binding CzPort}" HorizontalAlignment="Center" Width="320"/>

          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button Classes="primary" Content="连接" Click="OnConnectSourceClick"/>
            <TextBlock Classes="label" Text="{Binding SourceHint}" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- ⑥ 登录 / 注册 -->
      <Grid Grid.Row="1" IsVisible="{Binding IsAccount}" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Spacing="6" HorizontalAlignment="Center">
          <TextBlock Classes="h2" Text="登录账号" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
          <Ellipse Width="68" Height="68" Fill="#BFD9E8" HorizontalAlignment="Center"/>

          <TextBlock Classes="label" Text="账号名称" HorizontalAlignment="Center"/>
          <TextBox Classes="field" Text="{Binding UserName}" HorizontalAlignment="Center" Width="320"/>

          <TextBlock Classes="label" Text="账号密码" HorizontalAlignment="Center"/>
          <TextBox Classes="field" Text="{Binding Password}" PasswordChar="•" HorizontalAlignment="Center" Width="320"/>

          <CheckBox Content="登录管理账号" IsChecked="{Binding IsAdminAccount}" HorizontalAlignment="Center"/>

          <ComboBox IsVisible="{Binding AdminSideVisible}" SelectedIndex="{Binding AdminSideIndex}" FontSize="13"
                    CornerRadius="0" Padding="6,3" HorizontalAlignment="Center" Width="320">
            <ComboBoxItem Content="ZXMS 管理账号"/>
            <ComboBoxItem Content="ZXMOS 管理账号"/>
          </ComboBox>

          <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" FontSize="13" CornerRadius="0"
                    Padding="6,3" HorizontalAlignment="Center" Width="320"
                    IsVisible="{Binding IsAdminAccount}"/>

          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button Classes="primary" Content="登录" Click="OnLoginClick" IsEnabled="{Binding !IsBusy}" MinWidth="90"/>
            <Button Classes="secondary" Content="注册" Click="OnRegisterClick"
                    IsVisible="{Binding CanRegister}" IsEnabled="{Binding !IsBusy}" MinWidth="90"/>
          </StackPanel>

          <TextBlock Classes="body" Text="{Binding Message}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>

      <!-- S1:来自 ZXMS 的欢迎信息(占位) -->
      <Grid Grid.Row="1" IsVisible="{Binding IsWelcomeInfo}" RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Classes="h2" Text="来自 ZXMS 的欢迎信息"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">
          <TextBlock Classes="body" Text="(占位:这里以后显示子服务端下发的欢迎语)" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>

      <!-- S2:来自 ZXMS 的介绍信息(占位) -->
      <Grid Grid.Row="1" IsVisible="{Binding IsIntroInfo}" RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Classes="h2" Text="来自 ZXMS 的介绍信息"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">
          <TextBlock Classes="body" Text="(占位:这里以后显示子服务端下发的服务器介绍)" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>

      <!-- ⑦ 开始使用 -->
      <Grid Grid.Row="1" IsVisible="{Binding IsFinish}">
        <TextBlock Classes="h1" Text="开始使用你的ZincXManager吧！" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center"/>
      </Grid>
    </Grid>

    <!-- 底部按钮 -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                VerticalAlignment="Center" Margin="32,0,32,20">
      <Button Classes="secondary" Content="上一步" Click="OnBackClick" IsEnabled="{Binding CanGoBack}"/>
      <Button Classes="primary" Content="{Binding NextText}" Click="OnNextClick" IsEnabled="{Binding CanGoNext}"/>
    </StackPanel>
  </Grid>
</Window>
