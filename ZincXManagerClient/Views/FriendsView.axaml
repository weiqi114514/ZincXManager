<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ZincXManagerClient.Views.FriendsView">

  <Grid RowDefinitions="Auto,*" Margin="18,16,16,16">
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Text="好友" FontSize="22" FontWeight="SemiBold" Foreground="#1F3B3A"/>
      <Rectangle Width="34" Height="2.5" Fill="{DynamicResource ThemePrimary}" HorizontalAlignment="Left"/>
    </StackPanel>

    <!-- 预留:老版 QQ / Steam 那种两栏好友窗口 -->
    <Border Grid.Row="1" Margin="0,16,0,0"
            Background="{DynamicResource ThemeGlassLight}" BorderBrush="{DynamicResource ThemePanelBorder}"
            BorderThickness="1">
      <Grid ColumnDefinitions="240,*">

        <!-- 左:好友列表(占位) -->
        <Border Grid.Column="0" Background="{DynamicResource ThemeLight}"
                BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="0,0,1,0">
          <Grid RowDefinitions="Auto,Auto,*">
            <TextBlock Grid.Row="0" Text="好友" FontSize="13" FontWeight="SemiBold" Margin="14,12,14,8"
                       Foreground="{DynamicResource ThemePrimaryDark}"/>
            <TextBox Grid.Row="1" Margin="14,0,14,8" Watermark="搜索好友" FontSize="12"/>
            <TextBlock Grid.Row="2" Text="暂无好友" FontSize="12" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource ThemeMuted}"/>
          </Grid>
        </Border>

        <!-- 右:聊天区(占位) -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="0,0,0,1" Padding="14,10">
            <TextBlock Text="选择一个好友开始聊天" FontSize="13" Foreground="{DynamicResource ThemePrimaryDark}"/>
          </Border>
          <TextBlock Grid.Row="1" Text="聊天区(预留)" FontSize="12.5" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Foreground="{DynamicResource ThemeMuted}"/>
          <Border Grid.Row="2" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Watermark="输入消息…" FontSize="12.5" IsEnabled="False"/>
              <Button Grid.Column="1" Classes="small" Content="发送" Margin="8,0,0,0" IsEnabled="False"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
