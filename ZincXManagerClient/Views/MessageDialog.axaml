<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZincXManagerClient.Views.MessageDialog"
        Title="ZincXManagerClient 弹窗"
        Width="420" SizeToContent="Height" MaxHeight="620"
        Background="#CCFFFFFF"
        TransparencyLevelHint="AcrylicBlur,Blur,Transparent"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <!-- 标题栏按钮:背景撑满高度,不然上下留白、点击区也小 -->
    <Style Selector="Button.chrome">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.chrome /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimaryHover}"/>
    </Style>
    <Style Selector="Button.close">
      <Setter Property="Background" Value="#E81123"/>
    </Style>
    <Style Selector="Button.close /template/ ContentPresenter">
      <Setter Property="Background" Value="#E81123"/>
    </Style>
    <Style Selector="Button.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F1707A"/>
    </Style>

    <Style Selector="TextBlock.dtitle">
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1F3B3A"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.dtext">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#4A6B78"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.dhint">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="#A9B7BF"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 填空 / 选择:和主界面输入框同一套样子 -->
    <Style Selector="TextBox.dfield">
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#C7DCE8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style Selector="ComboBox.dfield">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#C7DCE8"/>
    </Style>

    <!-- 右下按钮:主按钮 = 主题色,次按钮 = 浅色 -->
    <Style Selector="Button.dbtn">
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="84"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.dbtn.primary">
      <Setter Property="Background" Value="{DynamicResource ThemePrimary}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.dbtn.primary /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimary}"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.dbtn.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemePrimaryHover}"/>
    </Style>
    <Style Selector="Button.dbtn.secondary">
      <Setter Property="Background" Value="{DynamicResource ThemeLight}"/>
      <Setter Property="Foreground" Value="#1F3B3A"/>
    </Style>
    <Style Selector="Button.dbtn.secondary /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeLight}"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.dbtn.secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeSecondary}"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="40,*,Auto">

    <!-- 标题栏:左侧白色小条 + 弹窗名 + 红色关闭(和设计稿一致) -->
    <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource ThemePrimary}" PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Rectangle x:Name="TitleMark" Grid.Column="0" Width="1.5" Height="16" Fill="#80FFFFFF" Margin="16,0,0,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="BarTitle" Grid.Column="1" Text="ZincXManagerClient弹窗" Foreground="White" FontSize="13"
                   Margin="14,0,0,0" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Classes="chrome close" Width="54" Click="OnCloseClick">
          <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="White" StrokeThickness="1.7"/>
        </Button>
      </Grid>
    </Border>

    <!-- 正文:大标题 + 说明 + (可选)填空 / 选择 -->
    <StackPanel Grid.Row="1" Margin="24,22,24,8" Spacing="12">
      <TextBlock x:Name="TitleText" Classes="dtitle" Text="请输入标题"/>
      <TextBlock x:Name="BodyText" Classes="dtext" Text="请输入文本"/>
      <TextBox x:Name="InputBox" Classes="dfield" IsVisible="False" KeyDown="OnInputKeyDown"/>
      <ComboBox x:Name="ChoiceBox" Classes="dfield" IsVisible="False"/>
    </StackPanel>

    <!-- 底栏:左下淡色提示,右下按钮 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="24,10,24,16">
      <TextBlock x:Name="HintText" Grid.Column="0" Classes="dhint" VerticalAlignment="Center"/>
      <StackPanel x:Name="ButtonsHost" Grid.Column="1" Orientation="Horizontal" Spacing="10"/>
    </Grid>
  </Grid>
</Window>
