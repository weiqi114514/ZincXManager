<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.1.1</Version>
    <FileVersion>0.1.1.0</FileVersion>
    <InformationalVersion>b0.1.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>..\assets\zxm.ico</ApplicationIcon>
    <RootNamespace>ZincXManagerClient</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 客户端交付形态就是 NativeAOT 单文件:直接 build/publish 即按 AOT 走,不必再手加 -p:PublishAot=true。
         (libSkiaSharp / av_libglesv2 / libHarfBuzzSharp 三个原生 dll 折不进去,交付时与主程序同目录) -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <!-- 开发期诊断面板:只在 Debug 引用(Release / AOT 交付包里不带它) -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 与 ZXMS / ZXMOS 共用同一套 Logging / FileIO(位于项目目录之外) -->
    <ProjectReference Include="..\ZincXManagerShared\ZincXManagerShared.csproj" />
  </ItemGroup>
</Project>
