<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ZincXManagerShared</RootNamespace>
    <AssemblyName>ZincXManagerShared</AssemblyName>
    <!-- 三个端(ZXMC/ZXMS/ZXMOS)共用,必须兼容 AOT 发布 -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- 版本跟着主版本走:显示用 b0.2.0a,文件版本必须纯数字 -->
    <Version>0.2.0</Version>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>b0.2.0a</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 正版许可证:ECDSA 签名 + XML 格式(GitHub: junian/Standard.Licensing,MIT) -->
    <PackageReference Include="Standard.Licensing" Version="1.3.1" />
  </ItemGroup>

</Project>
