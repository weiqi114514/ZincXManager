using System.Security.Cryptography;

namespace ZincXManagerShared.Verify;

/// <summary>
/// 内置的<b>官方公钥</b>(RSA-2048),只能验签、不能签发。
///
/// <para>存放方式:模数先和一段由 <c>Seed</c> 链式 SHA-256 出来的密钥流异或过,再用字节数组存 ——
/// 目的是让 <c>strings</c> / 直接搜 PEM 或十六进制模数的人搜不到;
/// <b>它挡不住铁了心的逆向</b>(公钥本来就要参与运算,迟早要在内存里还原)。
/// 真正的保险是<b>私钥不出厂</b> + 官方对端也验它。</para>
///
/// <para>本文件由签发工具 <c>zxm-lic keygen</c> 自动生成,换钥匙就重新生成,别手改。</para>
/// </summary>
internal static class OfficialKey
{
    /// <summary>打散后的模数(256 字节 = RSA-2048)。</summary>
    private static readonly byte[] Vault =
    [
        0x12, 0xF1, 0x36, 0x76, 0x98, 0xE6, 0x6E, 0x57, 0x60, 0xD9, 0xAD, 0xE7, 
        0x97, 0xE9, 0x77, 0x89, 0x8A, 0x4B, 0xB7, 0xAF, 0xFD, 0x92, 0x31, 0x71, 
        0x35, 0xC1, 0x54, 0xA5, 0x07, 0xAF, 0xE6, 0x78, 0xF0, 0x83, 0x64, 0x2A, 
        0x71, 0xCA, 0x70, 0x0F, 0x1C, 0x3F, 0x1C, 0xF1, 0xFF, 0xC9, 0x9E, 0xBF, 
        0xFB, 0x40, 0x61, 0xE9, 0x42, 0x2B, 0x5E, 0xC6, 0x98, 0x63, 0xD5, 0x6A, 
        0x5C, 0x6F, 0xEE, 0x59, 0xCB, 0xB3, 0x47, 0x6B, 0xCC, 0xA7, 0xE2, 0x5A, 
        0x79, 0xD3, 0xC3, 0x2B, 0x7A, 0x15, 0x1B, 0xC9, 0x14, 0xFB, 0xDD, 0xFD, 
        0x4C, 0xFA, 0x39, 0x4F, 0x0C, 0x4A, 0x6B, 0x8C, 0xB2, 0x27, 0xF1, 0x91, 
        0x9B, 0x40, 0xBB, 0x45, 0xA5, 0x50, 0xD1, 0x61, 0xA6, 0xE7, 0xB7, 0x4B, 
        0x4C, 0x68, 0x21, 0x83, 0x72, 0xE4, 0xC4, 0x61, 0xC9, 0xDF, 0xA7, 0x2B, 
        0x9D, 0x61, 0xA2, 0xE6, 0x5B, 0xAF, 0x2E, 0x52, 0xFD, 0xD4, 0x1D, 0xEC, 
        0x38, 0xAA, 0x09, 0xEB, 0x2B, 0x25, 0x10, 0x3F, 0xFA, 0x3F, 0x09, 0x2A, 
        0xE8, 0x17, 0xAC, 0x5F, 0xF3, 0x5F, 0xA8, 0x64, 0x22, 0x1D, 0xC2, 0xA4, 
        0x3D, 0x74, 0x24, 0x2D, 0xB9, 0x8A, 0x44, 0x7D, 0xB3, 0xB1, 0x62, 0x23, 
        0x44, 0xC8, 0xD9, 0x99, 0xA8, 0xE7, 0x16, 0x75, 0x53, 0x5E, 0x55, 0x5C, 
        0x51, 0xA2, 0x34, 0x19, 0x33, 0x7D, 0xC8, 0xE9, 0xDE, 0x81, 0x36, 0x3C, 
        0x06, 0x40, 0x03, 0x76, 0x03, 0x14, 0xAE, 0x7D, 0x6D, 0x88, 0x9D, 0xCB, 
        0x55, 0x92, 0x07, 0x5E, 0x90, 0x69, 0x00, 0xCB, 0x0D, 0x77, 0x65, 0x9D, 
        0xE6, 0x0C, 0xBD, 0x7E, 0xC5, 0x7D, 0x7E, 0xA4, 0xD9, 0x3C, 0x58, 0xC8, 
        0x4E, 0x2D, 0xEE, 0x02, 0xC5, 0x18, 0x54, 0xCD, 0x65, 0x0D, 0x8B, 0x33, 
        0x14, 0xEE, 0xBD, 0xF8, 0x42, 0x6B, 0x2F, 0x2C, 0x29, 0x24, 0x14, 0xBE, 
        0x83, 0xDD, 0x72, 0x1F
    ];

    /// <summary>还原密钥流的种子(32 字节)。</summary>
    private static readonly byte[] Seed =
    [
        0x3B, 0x7B, 0xDD, 0xD8, 0x21, 0x29, 0x34, 0x84, 0xDF, 0x18, 0x96, 0x5E, 
        0x09, 0x67, 0xB9, 0x04, 0x2C, 0x2B, 0xE1, 0x34, 0xA9, 0x78, 0xED, 0xF0, 
        0x49, 0x4D, 0xFA, 0x10, 0x69, 0xB9, 0x96, 0xB8
    ];

    /// <summary>造一把只能验签的公钥(RSA 验签在 AOT 下走系统 CNG,不需要额外依赖)。</summary>
    public static RSA? Create()
    {
        try
        {
            if (Vault.Length != 256 || Seed.Length != 32)
            {
                return null;
            }

            var stream = Keystream(Vault.Length);
            var modulus = new byte[Vault.Length];
            for (var i = 0; i < modulus.Length; i++)
            {
                modulus[i] = (byte)(Vault[i] ^ stream[i]);
            }

            var rsa = RSA.Create();
            rsa.ImportParameters(new RSAParameters
            {
                Modulus = modulus,
                Exponent = [0x01, 0x00, 0x01],   // 65537
            });

            return rsa;
        }
        catch
        {
            return null;
        }
    }

    /// <summary>链式 SHA-256 铺开的密钥流(和 Seed 一起由签发工具生成)。</summary>
    private static byte[] Keystream(int length)
    {
        var output = new byte[length];
        var block = Seed;
        var offset = 0;

        while (offset < length)
        {
            block = SHA256.HashData(block);
            var take = Math.Min(block.Length, length - offset);
            Array.Copy(block, 0, output, offset, take);
            offset += take;
        }

        return output;
    }
}
